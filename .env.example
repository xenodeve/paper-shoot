# Copy to .env and fill in. Read by the server only — never shipped to the browser.
# Your OpenCode Go key (the same one opencode uses for the opencode-go provider).
OPENCODE_GO_API_KEY=
# OpenAI-compatible endpoint of OpenCode Go.
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Any OpenAI-compatible model on your Go plan, e.g. glm-5.3-flash, deepseek-v4.1-flash, kimi-k3
OPENCODE_GO_MODEL=glm-5.3-flash
